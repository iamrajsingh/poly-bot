# Copy to .env and fill in. Every setting in polyengine/config.py can be overridden with PE_<NAME>.

# --- Claude (research + cross-venue matching) ---
ANTHROPIC_API_KEY=
# PE_ANTHROPIC_MODEL=claude-opus-5-5
# PE_FORECAST_EFFORT=medium
PE_MAX_LLM_USD_PER_DAY=10
PE_MAX_LLM_CALLS_PER_DAY=300

# --- Mode ---
# Paper trading is the default. Live needs BOTH this flag AND `polyengine run --live`.
PE_LIVE_TRADING=false
PE_PAPER_STARTING_CASH=1000

# --- Polymarket wallet (live only) ---
PE_PM_PRIVATE_KEY=
# Proxy wallet address shown on polymarket.com (leave empty for a plain EOA)
PE_PM_FUNDER=
# 0 = EOA, 1 = email/Magic login, 2 = browser-wallet proxy
PE_PM_SIGNATURE_TYPE=1

# --- Risk (start small; raise only after reviewing paper results) ---
PE_MAX_POSITION_USD=50
PE_MAX_POSITION_PCT_BANKROLL=0.05
PE_MAX_TOTAL_EXPOSURE_PCT=0.60
PE_MAX_DAILY_LOSS_PCT=0.05
PE_KELLY_FRACTION=0.25
PE_MIN_EDGE=0.04
PE_MIN_AGREEING_SOURCES=2
